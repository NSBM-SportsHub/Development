# Copy to .env for private local settings. Actual process variables take priority.
# Generate your own key: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SPORTSHUB_ENV=development
SPORTSHUB_APP_KEY=

# This workstation's portable MariaDB uses 3307. XAMPP commonly uses 3306.
# Set your own database account. These defaults are for the loopback development instance.
SPORTSHUB_DB_HOST=127.0.0.1
SPORTSHUB_DB_PORT=3307
SPORTSHUB_DB_NAME=nsbm_sportshub
SPORTSHUB_DB_USER=root
SPORTSHUB_DB_PASSWORD=

SPORTSHUB_SESSION_SECURE=0
SPORTSHUB_SESSION_PATH=

# Quote passwords containing whitespace or #. Dollar signs stay literal (no expansion).
# Use single quotes for literal Windows paths so backslashes remain unchanged.
